PAYMENT_MODE=mock
# 接入余宽 V2 时设置 PAYMENT_MODE=epay，并将 APP_URL 改为公网 HTTPS 域名。
# 网关以 /xpay/epayn/ 结尾；请核对后台当前线路。
EPAY_GATEWAY=https://zf.yk520.top/xpay/epayn/
EPAY_PID=
# 商户私钥（PKCS8 PEM 或裸 Base64）；仅放服务器环境变量。
EPAY_PRIVATE_KEY=
# 平台公钥（不是应用/商户公钥）。支持 PEM、裸 Base64 或字面量 \n。
EPAY_PUBLIC_KEY=
LICENSE_KEY_SECRET=replace-with-a-32-character-secret
AUTH_SESSION_SECRET=replace-with-a-long-customer-session-secret
ADMIN_TOKEN=replace-with-a-long-admin-token
CLOUDFLARE_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUD=your-access-application-audience
NEXT_PUBLIC_STORE_NAME=数字授权中心
DATABASE_PATH=./data/card-store.sqlite
SEED_DEMO_CATALOG=true
APP_URL=http://localhost:3000
ALIPAY_MODE=sandbox
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_KEY_TYPE=PKCS8
RESEND_API_KEY=
MAIL_FROM=Reii Shop <delivery@mail.reiishop.cn>
SUPPORT_EMAIL=support@reiishop.cn
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=localhost,reiishop.cn
